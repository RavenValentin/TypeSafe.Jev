<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>

    <!-- IsAotCompatible on the library only proves its analyzers are quiet. This project publishes a real
         native binary and runs it, so the trimmer and the AOT compiler get a say too. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimMode>full</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TypeSafe.Jev\TypeSafe.Jev.csproj" />
  </ItemGroup>

</Project>
